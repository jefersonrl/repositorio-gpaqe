# ------------------------------------------------------------------ aplicação
PORT=3000
NODE_ENV=development
SESSION_SECRET=troque-este-valor-em-producao
BASE_URL=http://localhost:3000

# ------------------------------------------------------------------ banco
# Em nuvem, o provedor costuma entregar uma URL única. Quando DB_URL existe,
# ela tem prioridade sobre as variáveis separadas abaixo.
# DB_URL=mysql://usuario:senha@host:3306/nome_do_banco?ssl-mode=REQUIRED
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=gpaqe
DB_PASSWORD=senha-do-banco
DB_NAME=gpaqe

# TLS na conexão com o banco. Informe DB_SSL_CA com o certificado da autoridade
# certificadora do provedor para que o certificado do servidor seja conferido.
DB_SSL=false
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# ------------------------------------------------------------------ arquivos
# "local" para desenvolvimento, "s3" em produção.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
MAX_UPLOAD_MB=500
URL_ASSINADA_MINUTOS=10

# Usado apenas quando STORAGE_DRIVER=s3. Funciona com Amazon S3,
# Google Cloud Storage, Cloudflare R2, Backblaze B2 e MinIO.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------ operação
DIAS_CARENCIA_LIXEIRA=30

# Prepara o banco na primeira subida, para hospedagem sem acesso ao terminal.
MIGRAR_AO_SUBIR=false

# Mostra o aviso de demonstração e a lista de contas de exemplo na tela de
# entrada. Nunca deixe ligado em um ambiente com dados reais.
MODO_DEMONSTRACAO=false
