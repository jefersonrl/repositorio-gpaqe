<%- include('../partials/cabecalho') %>
<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
  <div>
    <h1 class="h4 mb-1"><%= projeto.nome %></h1>
    <p class="text-body-secondary small mb-0"><%= projeto.sigla %></p>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <a class="btn btn-sm btn-outline-secondary" href="/projetos/<%= projeto.id %>/pessoas">Pessoas e perfis</a>
    <% if (ehCoordenacao) { %>
      <a class="btn btn-sm btn-outline-secondary" href="/projetos/<%= projeto.id %>/convites">Convites</a>
      <a class="btn btn-sm btn-outline-secondary" href="/projetos/<%= projeto.id %>/acessos">Acessos</a>
      <a class="btn btn-sm btn-outline-secondary" href="/projetos/<%= projeto.id %>/auditoria">Auditoria</a>
      <a class="btn btn-sm btn-outline-secondary" href="/projetos/<%= projeto.id %>/lixeira">Lixeira</a>
    <% } %>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="card shadow-sm">
      <div class="card-header fw-semibold">Estrutura do projeto</div>
      <ul class="list-group list-group-flush lista-pastas">
        <% raizes.forEach(function (p) { %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <span>
              <a href="/pastas/<%= p.id %>"><%= p.nome %></a>
              <% if (p.sensivel) { %><span class="badge text-bg-danger-subtle text-danger ms-1">sensível</span><% } %>
              <% if (p.publica) { %><span class="badge text-bg-success-subtle text-success ms-1">pública</span><% } %>
              <br><span class="small text-body-secondary"><%= p.descricao || '' %></span>
            </span>
            <%- include('../partials/nivel', { nivel: p.nivel }) %>
          </li>
        <% }); %>
      </ul>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card shadow-sm">
      <div class="card-header fw-semibold">Núcleos e frentes</div>
      <ul class="list-group list-group-flush">
        <% if (!nucleos.length) { %>
          <li class="list-group-item text-body-secondary small">Nenhum núcleo cadastrado.</li>
        <% } %>
        <% nucleos.forEach(function (n) { %>
          <li class="list-group-item"><%= n.nome %></li>
        <% }); %>
      </ul>
      <% if (ehCoordenacao) { %>
        <div class="card-body border-top">
          <form method="post" action="/projetos/<%= projeto.id %>/nucleos">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <label class="form-label" for="nucleo">Novo núcleo ou frente</label>
            <div class="input-group">
              <input class="form-control" id="nucleo" name="nome" required>
              <button class="btn btn-outline-primary">Criar</button>
            </div>
            <p class="form-text mb-0">Cria a pasta dentro da 07 com as subpastas padrão.</p>
          </form>
        </div>
      <% } %>
    </div>
  </div>
</div>
<%- include('../partials/rodape') %>
