<%- include('../partials/cabecalho') %>
<nav class="mb-2"><a class="small" href="/publico">Voltar aos projetos</a></nav>
<h1 class="h5 mb-1"><%= projeto.nome %></h1>
<p class="small text-body-secondary mb-4"><%= pasta.descricao || '' %></p>
<div class="card shadow-sm">
  <div class="card-header fw-semibold">Material disponível</div>
  <ul class="list-group list-group-flush">
    <% if (!arquivos.length) { %>
      <li class="list-group-item small text-body-secondary">Nenhum material publicado.</li>
    <% } %>
    <% arquivos.forEach(function (a) { %>
      <li class="list-group-item d-flex justify-content-between align-items-center">
        <span><%= a.nome %><br><span class="small text-body-secondary"><%= a.descricao || '' %> <%= tamanho(a.tamanho_bytes) %></span></span>
        <a class="btn btn-sm btn-outline-primary" href="/publico/arquivos/<%= a.id %>/baixar">Baixar</a>
      </li>
    <% }); %>
  </ul>
</div>
<%- include('../partials/rodape') %>
